    <Setting Name="vCenter_InformationQuery" Type="System.String" Scope="User">
      <Value Profile="(Default)">SELECT VMID
     , NAME
     , MEM_SIZE_MB
     , NUM_VCPU
     , POWER_STATE
     , ISNULL(CASE [Guest_OS] 
         WHEN 'centosGuest' THEN 'CENTOS' 
         WHEN 'other26xLinux64Guest' THEN 'Linux 2.6 Kernel x64' 
         WHEN 'other26xLinuxGuest' THEN 'Linux 2.6 Kernel x86' 
         WHEN 'otherGuest' THEN 'Unknown'
         WHEN 'redhatGuest' THEN 'Red Hat x86' 
         WHEN 'rhel4_64Guest' THEN 'Red Hat Enterprise Linux 4 x64' 
         WHEN 'rhel5Guest' THEN 'Red Hat Enterprise Linux 5 x86' 
         WHEN 'sles11_64Guest' THEN 'SUSE Linux Enterprise Server 11 x64'
         WHEN 'win2000ServGuest' THEN 'Windows Server 2000 Standard x86' 
         WHEN 'windows7Guest' THEN 'Windows 7 x86' 
         WHEN 'windows7_64Guest' THEN 'Windows 7 x64' 
         WHEN 'windows8Server64Guest' THEN 'Windows Server 2012 x64' 
         WHEN 'windows7Server64Guest' THEN 'Windows Server 2008 R2 x64' 
         WHEN 'winLonghorn64Guest' THEN 'Windows Server 2008 x64' 
         WHEN 'winLonghornGuest' THEN 'Windows Server 2008 x86'
         WHEN 'winNetEnterpriseGuest' THEN 'Windows Server 2003 Enterprise x86' 
         WHEN 'winNetStandard64Guest' THEN 'Windows Server 2003 Standard x64' 
         WHEN 'winNetStandardGuest' THEN 'Windows Server 2003 Standard x86'
         WHEN 'winVistaGuest' THEN 'Windows Vista x86' 
         WHEN 'winXPProGuest' THEN 'Windows XP Professional x86' 
         WHEN 'winNetEnterprise64Guest' THEN 'Windows Server 2003 Enterprise x64' 
         WHEN 'oracleLinux64Guest' THEN 'Oracle Linux x64' 
         WHEN 'freebsd64Guest' THEN 'FreeBSD x64' 
         WHEN 'ubuntu64Guest' THEN 'Ubuntu x64' 
         WHEN 'solaris10Guest' THEN 'Solaris 10 x86' 
         WHEN 'solaris10_64Guest' THEN 'Solaris 10 x64'
         WHEN 'otherLinux64Guest' THEN 'Linux x64' 
         ELSE Guest_OS 
       END,'') AS GuestOS
     , ISNULL(GUEST_FAMILY,'')
     , MEMORY_OVERHEAD / (1024 * 1024) AS Mem_Ovhd
     , ISNULL(REPLACE(UPPER(DNS_NAME), '.CORP.EXAMPLE.ORG', ''),'') AS DNS_NAME
     , ISNULL(IP_ADDRESS,'')
     , VMMWARE_TOOL
     , NUM_NIC
     , NUM_DISK
     , CASE [IS_TEMPLATE] 
         WHEN 1 THEN 'True' 
         WHEN 0 THEN 'False' 
       END AS Template
     , DESCRIPTION
     , ANNOTATION
     , CONVERT(DECIMAL(10, 0), ROUND(AGGR_COMMITED_STORAGE_SPACE / (1024 * 1024), 0)) AS Agg_CommDiskMB
     , CONVERT(DECIMAL(10, 0), ROUND(AGGR_UNCOMMITED_STORAGE_SPACE / (1024 * 1024), 0)) AS Agg_UnCommDiskMB
     , CONVERT(DECIMAL(10, 0), ROUND(AGGR_UNSHARED_STORAGE_SPACE / (1024 * 1024), 0)) AS Agg_UnSharDiskMB
FROM VPXV_VMS WITH (NOLOCK, NOWAIT)
ORDER BY NAME</Value>
    </Setting>
    <Setting Name="vCenter_StorageQuery" Type="System.String" Scope="User">
      <Value Profile="(Default)">SELECT VM.NAME
     , ISNULL(REPLACE(UPPER(VM.DNS_NAME), '.CORP.EXAMPLE.ORG', ''),'') AS DNS_NAME
     , VVD.DEVICE_INFO_LABEL AS DISK_LABEL
     , CAST(VD.HARDWARE_DEVICE_CAPACITY_IN AS BIGINT) / (1024 * 1024) AS DiskSizeGB
     , DS.NAME AS DATASTORE
FROM VPX_VDEVICE_FILE_BACKING_X AS FBX WITH (NOLOCK, NOWAIT) 
INNER JOIN VPX_VDEVICE_FILE_BACKING AS FB WITH (NOLOCK, NOWAIT) ON FB.BACKING_ID = FBX.BACKING_ID 
INNER JOIN VPXV_VMS AS VM WITH (NOLOCK, NOWAIT) ON VM.VMID = FBX.VM_ID 
INNER JOIN VPXV_DATASTORE AS DS WITH (NOLOCK, NOWAIT) ON DS.ID = FB.DATASTORE_ID 
INNER JOIN VPX_VIRTUAL_DISK AS VD WITH (NOLOCK, NOWAIT) ON FB.VM_ID = VD.VM_ID AND FB.UPDATE_KEY = VD.UPDATE_KEY 
INNER JOIN VPX_VIRTUAL_DEVICE AS VVD WITH (NOLOCK, NOWAIT) ON VVD.VDEVICE_ID = VD.VDEVICE_ID
ORDER BY VM.NAME</Value>
    </Setting>
